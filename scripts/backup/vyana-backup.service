[Unit]
Description=Nightly backup of the Vyana database (see RUNBOOK.md)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
# The path of the repository on the server: change it if it is not here.
ExecStart=/usr/bin/python3 /home/ubuntu/vyana/scripts/backup/backup-db.py
# Where the connection string is, and where the dumps go (both outside the repository).
Environment=BACKUP_ENV_FILE=/home/ubuntu/.vyana-backup.env
Environment=BACKUP_DIR=/home/ubuntu/vyana-backups
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
