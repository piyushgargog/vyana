{
  "name": "vyana",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @vyana/web dev",
    "dev:mobile": "pnpm --filter @vyana/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "docs:openapi": "node scripts/generate-openapi.mts",
    "smoke:tinyfish": "pnpm --filter @vyana/web smoke:tinyfish",
    "smoke:basket": "pnpm --filter @vyana/web smoke:basket",
    "verify:interactions": "pnpm --filter @vyana/web verify:interactions",
    "verify:red-flags": "pnpm --filter @vyana/web verify:red-flags"
  },
  "devDependencies": {
    "turbo": "^2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.11.2"
}
