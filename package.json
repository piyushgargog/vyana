{
  "name": "vyana",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @vyana/web dev",
    "dev:mobile": "pnpm --filter @vyana/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "docs:openapi": "node scripts/generate-openapi.mts",
    "verify:interactions": "pnpm --filter @vyana/web verify:interactions",
    "verify:red-flags": "pnpm --filter @vyana/web verify:red-flags",
    "verify:brands": "pnpm --filter @vyana/web verify:brands",
    "live:check": "pnpm --filter @vyana/web live:check",
    "review:sheet": "pnpm --filter @vyana/web review:sheet",
    "eval:safety": "pnpm --filter @vyana/web eval:safety",
    "e2e": "playwright test",
    "seed:demo:refresh": "pnpm --filter @vyana/web exec tsx ../../supabase/seed/refresh-demo.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.64.0",
    "turbo": "^2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.11.2"
}
