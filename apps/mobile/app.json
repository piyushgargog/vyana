{
  "expo": {
    "name": "Vyana",
    "slug": "vyana",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vyana",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.vyana.health"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D9488",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.vyana.health",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_WEIGHT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 104
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "doses",
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0D9488"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vyana needs your location to dispatch emergency services and alert contacts during an SOS."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vyana needs access to your photos to upload prescriptions and medical reports.",
          "cameraPermission": "Vyana needs access to your camera to scan prescriptions and lab reports.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Vyana reads your steps, heart rate, sleep and similar readings to show them to you and, only if you share them, to your doctor. It does not write to Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-background-task",
      "expo-task-manager",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5bb073d5-dea8-41ec-a6d7-ace3cdd92d75"
      }
    },
    "owner": "piyushgargog"
  }
}
