{
  "expo": {
    "name": "Vyana",
    "slug": "vyana",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vyana",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.vyana.health"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D9488",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vyana.health",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "doses",
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0D9488"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vyana needs your location to dispatch emergency services and alert contacts during an SOS."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vyana needs access to your photos to upload prescriptions and medical reports.",
          "cameraPermission": "Vyana needs access to your camera to scan prescriptions and lab reports.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5bb073d5-dea8-41ec-a6d7-ace3cdd92d75"
      }
    },
    "owner": "piyushgargog"
  }
}
