# Copy to .env.local (local) or .env.production (server) and fill in. Never commit those files.
# Put comments on their own line, never after a value: Docker Compose reads `KEY=  # text` as the value "# text".
# Variables without NEXT_PUBLIC_ stay on the server and never reach the browser or the mobile app.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_USE_MOCKS=false

# App
# used in share links and as the scheduled-job target
APP_URL=http://localhost:3000

# TinyFish (agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=
# optional pool: key1,key2,key3,key4 (runs rotate across them). Check TinyFish's terms on several accounts first
TINYFISH_API_KEYS=
# 1 = fixtures, no network calls
TINYFISH_MOCK=0

# LLM: provider chosen after evaluation (google | groq | nvidia | openrouter | huggingface). In production only groq
# may see patient text (ADR-051); the others are for evaluation and the synthetic demo users.
LLM_PROVIDER=
# must support images + PDF
LLM_MODEL=
# optional: a cheaper text-only model for chat, care plans, triage (default: LLM_MODEL)
LLM_TEXT_MODEL=
# fixtures until the provider is chosen
LLM_MOCK=1
# 1 only after the provider's no-retention terms are recorded (prescription/report images)
LLM_VISION_APPROVED=0
GOOGLE_GENERATIVE_AI_API_KEY=
# turn on Zero Data Retention in its Data Controls before real patients
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
# More keys for a provider, comma separated (ADR-056): tried round-robin, one per call. A free-tier limit is per account, so use keys from different accounts.
# Same pattern for every provider: <KEY NAME>S, for example NVIDIA_API_KEYS or GOOGLE_GENERATIVE_AI_API_KEYS.
GROQ_API_KEYS=
# Fallback models, tried after the primary one on a limit (413, 429), an outage or a timeout: provider:model,provider:model
LLM_FALLBACKS=
# Same for images; only list models that read images.
LLM_VISION_FALLBACKS=
# 1 = let a provider without recorded terms run in production (never with real patients)
LLM_ALLOW_UNAPPROVED=0

# Webhooks and scheduled jobs
MONITOR_WEBHOOK_SECRET=
CRON_SECRET=
# 32+ random characters; encrypts background job ids
JOB_TOKEN_SECRET=
# optional: Expo "enhanced push security" for the caregiver push
EXPO_ACCESS_TOKEN=

# Demo data and live tests (scripts only, never set on the deployed app)
SEED_PASSWORD=
# pnpm live:check: the running API to test (or the deployed URL)
API_BASE=http://localhost:3000
