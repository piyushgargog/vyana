# Copy to .env.local and fill in. Never commit .env.local.
# Variables without NEXT_PUBLIC_ stay on the server and never reach the browser or the mobile app.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=                 # server only
NEXT_PUBLIC_USE_MOCKS=false

# App
APP_URL=http://localhost:3000              # used in share links and as the scheduled-job target

# TinyFish (agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=
TINYFISH_MOCK=0                            # 1 = fixtures, no network calls

# LLM: provider chosen after evaluation (google | anthropic | openai | nvidia)
LLM_PROVIDER=
LLM_MODEL=                                 # must support images + PDF
LLM_MOCK=1                                 # fixtures until the provider is chosen
LLM_VISION_APPROVED=0                      # 1 only after the provider's no-retention terms are recorded (prescription/report images)
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Webhooks and scheduled jobs
MONITOR_WEBHOOK_SECRET=
CRON_SECRET=
JOB_TOKEN_SECRET=                          # 32+ random characters; encrypts background job ids

# Demo data
SEED_PASSWORD=
